# Copy to .env and fill in. Never commit .env (see .gitignore).
# Used by ibgateway_manager Config and automation when running the CLI locally or in Docker.

# IBKR login (optional; required for automate-ibgateway)
# IBGATEWAY_USERNAME=
# IBGATEWAY_PASSWORD=

# API: IB_API or FIX
IB_API_TYPE=IB_API

# PAPER or LIVE
IB_TRADING_MODE=PAPER

# Virtual display for headless runs (matches orchestrator default)
DISPLAY=:99

RESOLUTION=1024x768
SCREENSHOT_DIR=/tmp/screenshots
SCREENSHOT_PORT=8080

# Set to 1 to skip GUI automation in start-services (services only)
# SKIP_AUTOMATION=0
